@page "/tickets"
@rendermode InteractiveServer
@attribute [Authorize]
@inject TicketApiClient Api
@inject NavigationManager Nav

<PageTitle>Ticket</PageTitle>

<h1>Board Ticket</h1>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

<EditForm Model="_newTicket" OnValidSubmit="CreateAsync" class="row g-2 mb-4 align-items-end">
    <div class="col-md-3">
        <label class="form-label">Titolo</label>
        <InputText class="form-control" @bind-Value="_newTicket.Title" required />
    </div>
    <div class="col-md-3">
        <label class="form-label">Descrizione</label>
        <InputText class="form-control" @bind-Value="_newTicket.Description" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Tipo</label>
        <InputSelect class="form-select" @bind-Value="_newTicket.Type">
            @foreach (var t in Enum.GetValues<TicketType>())
            {
                <option value="@t">@t</option>
            }
        </InputSelect>
    </div>
    <div class="col-md-2">
        <label class="form-label">Priorità</label>
        <InputSelect class="form-select" @bind-Value="_newTicket.Priority">
            @foreach (var p in Enum.GetValues<TicketPriority>())
            {
                <option value="@p">@p</option>
            }
        </InputSelect>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">+ Nuovo ticket</button>
    </div>
</EditForm>

@if (_loading)
{
    <p>Caricamento...</p>
}
else
{
    <div class="kanban-board">
        @foreach (var status in _columns)
        {
            <div class="kanban-column" @ondragover:preventDefault @ondrop="() => OnDropAsync(status)">
                <h6 class="kanban-column-title">@status (@GetTicketsForStatus(status).Count())</h6>
                @foreach (var ticket in GetTicketsForStatus(status))
                {
                    <div class="kanban-card @(IsBreached(ticket) ? "kanban-card-breach" : "")"
                         draggable="true"
                         @ondragstart="() => _draggedTicketId = ticket.Id"
                         @onclick="() => Nav.NavigateTo($"/tickets/{ticket.Id}")">
                        <div class="kanban-card-title">#@ticket.Id @ticket.Title</div>
                        <div class="kanban-card-meta">
                            <span class="badge bg-@PriorityColor(ticket.Priority)">@ticket.Priority</span>
                            <span class="badge bg-secondary">@ticket.Type</span>
                            @if (IsBreached(ticket))
                            {
                                <span class="badge bg-danger">SLA scaduto</span>
                            }
                        </div>
                        <div class="kanban-card-assignee">@(ticket.Assignee?.DisplayName ?? "Non assegnato")</div>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private List<Ticket> _tickets = new();
    private readonly TicketStatus[] _columns = Enum.GetValues<TicketStatus>();
    private int? _draggedTicketId;
    private bool _loading = true;
    private string? _error;
    private CreateTicketModel _newTicket = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _loading = true;
            _tickets = await Api.GetAllAsync();
            _error = null;
        }
        catch (Exception ex)
        {
            _error = $"Impossibile contattare ticket-api: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private IEnumerable<Ticket> GetTicketsForStatus(TicketStatus status) => _tickets.Where(t => t.Status == status);

    private async Task CreateAsync()
    {
        try
        {
            await Api.CreateAsync(_newTicket.Title, _newTicket.Description, _newTicket.Type, _newTicket.Priority);
            _newTicket = new CreateTicketModel();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = $"Creazione fallita: {ex.Message}";
        }
    }

    private async Task OnDropAsync(TicketStatus newStatus)
    {
        var draggedId = _draggedTicketId;
        _draggedTicketId = null;

        if (draggedId is null)
        {
            return;
        }

        var ticket = _tickets.FirstOrDefault(t => t.Id == draggedId);
        if (ticket is null || ticket.Status == newStatus)
        {
            return;
        }

        if (!ticket.AllowedNextStates.Contains(newStatus))
        {
            _error = $"Transizione non permessa: {ticket.Status} -> {newStatus}.";
            return;
        }

        try
        {
            await Api.TransitionAsync(ticket.Id, newStatus);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = $"Cambio stato fallito: {ex.Message}";
        }
    }

    private static bool IsBreached(Ticket t) =>
        t.Status is not (TicketStatus.Resolved or TicketStatus.Closed) && DateTime.UtcNow > t.ResolutionDueAt;

    private static string PriorityColor(TicketPriority p) => p switch
    {
        TicketPriority.Critical => "danger",
        TicketPriority.High => "warning",
        TicketPriority.Medium => "info",
        _ => "secondary",
    };

    private class CreateTicketModel
    {
        public string Title { get; set; } = string.Empty;
        public string? Description { get; set; }
        public TicketType Type { get; set; } = TicketType.Incident;
        public TicketPriority Priority { get; set; } = TicketPriority.Medium;
    }
}
