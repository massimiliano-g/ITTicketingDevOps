@inject AuthStateService AuthState
@inject NavigationManager Nav

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">TicketWeb</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="tickets">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Ticket
                    </NavLink>
                </div>

                @if (context.User.IsInRole("Admin"))
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin">Amministrazione</NavLink>
                    </div>
                }

                <div class="nav-item px-3 mt-3 text-white-50 small">
                    @context.User.Identity?.Name
                </div>
                <div class="nav-item px-3">
                    <button class="nav-link btn btn-link text-start p-0" @onclick="Logout">Esci</button>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">Accedi</NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private void Logout()
    {
        AuthState.Clear();
        Nav.NavigateTo("/login", forceLoad: true);
    }
}
