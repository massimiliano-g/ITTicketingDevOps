@page "/login"
@rendermode InteractiveServer
@inject TicketApiClient Api
@inject AuthStateService AuthState
@inject NavigationManager Nav

<PageTitle>Accedi</PageTitle>

<h1>Accedi</h1>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

<EditForm Model="_model" OnValidSubmit="SubmitAsync" class="col-md-4">
    <div class="mb-3">
        <label class="form-label">Email</label>
        <InputText class="form-control" @bind-Value="_model.Email" />
    </div>
    <div class="mb-3">
        <label class="form-label">Password</label>
        <InputText type="password" class="form-control" @bind-Value="_model.Password" />
    </div>
    <button type="submit" class="btn btn-primary" disabled="@_submitting">Accedi</button>
</EditForm>

<p class="mt-4 text-muted">
    Utenti demo: <code>admin@ticketsystem.local</code>, <code>agent@ticketsystem.local</code>,
    <code>requester@ticketsystem.local</code> — password <code>Demo123!</code>
</p>

@code {
    private readonly LoginFormModel _model = new();
    private string? _error;
    private bool _submitting;

    private async Task SubmitAsync()
    {
        _submitting = true;
        _error = null;

        try
        {
            var result = await Api.LoginAsync(_model.Email, _model.Password);
            AuthState.SetSession(result.Token, result.User);
            Nav.NavigateTo("/tickets");
        }
        catch (Exception)
        {
            _error = "Email o password non validi.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private class LoginFormModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
