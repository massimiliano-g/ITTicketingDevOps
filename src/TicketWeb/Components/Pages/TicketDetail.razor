@page "/tickets/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject TicketApiClient Api
@inject AuthenticationStateProvider AuthProvider
@inject AuthStateService AuthState
@inject NavigationManager Nav

<PageTitle>Ticket #@Id</PageTitle>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_ticket is null)
{
    <p>Caricamento...</p>
}
else
{
    <a href="/tickets" class="btn btn-link ps-0">&larr; Torna alla board</a>

    <h1>#@_ticket.Id — @_ticket.Title</h1>

    <div class="row mb-4">
        <div class="col-md-8">
            <p>@_ticket.Description</p>

            <div class="mb-3">
                <span class="badge bg-secondary">@_ticket.Type</span>
                <span class="badge bg-@PriorityColor(_ticket.Priority)">@_ticket.Priority</span>
                <span class="badge bg-dark">@_ticket.Status</span>
                @if (IsBreached(_ticket))
                {
                    <span class="badge bg-danger">SLA scaduto</span>
                }
            </div>

            @if (_isAgentOrAdmin && _ticket.AllowedNextStates.Any())
            {
                <div class="mb-4">
                    <label class="form-label">Cambia stato:</label>
                    @foreach (var next in _ticket.AllowedNextStates)
                    {
                        <button class="btn btn-outline-primary btn-sm me-2" @onclick="() => TransitionAsync(next)">
                            &rarr; @next
                        </button>
                    }
                </div>
            }

            <h4>Commenti</h4>
            @foreach (var comment in _comments)
            {
                <div class="border rounded p-2 mb-2">
                    <strong>@comment.Author.DisplayName</strong>
                    <span class="text-muted small">— @comment.CreatedAt.ToLocalTime().ToString("g")</span>
                    <p class="mb-0">@comment.Body</p>
                </div>
            }

            <EditForm Model="_newComment" OnValidSubmit="AddCommentAsync" class="mt-3">
                <InputTextArea class="form-control mb-2" rows="2" @bind-Value="_newComment.Body" placeholder="Scrivi un commento..." />
                <button type="submit" class="btn btn-primary btn-sm">Commenta</button>
            </EditForm>

            <h4 class="mt-4">Allegati</h4>
            @foreach (var attachment in _attachments)
            {
                <div class="mb-1">
                    <a href="/download/@Id/@attachment.Id?token=@AuthState.Token" target="_blank">@attachment.FileName</a>
                    <span class="text-muted small">
                        (@FormatSize(attachment.SizeBytes), caricato da @attachment.UploadedBy?.DisplayName)
                    </span>
                </div>
            }
            <InputFile OnChange="OnFileSelectedAsync" class="form-control form-control-sm mt-2" />
            @if (_uploading)
            {
                <span class="text-muted small">Caricamento...</span>
            }
        </div>

        <div class="col-md-4">
            <h5>Dettagli</h5>
            <ul class="list-unstyled small">
                <li><strong>Richiedente:</strong> @_ticket.Reporter?.DisplayName</li>
                <li><strong>Assegnatario:</strong> @(_ticket.Assignee?.DisplayName ?? "Non assegnato")</li>
                <li><strong>Creato:</strong> @_ticket.CreatedAt.ToLocalTime().ToString("g")</li>
                <li><strong>Scadenza risposta:</strong> @_ticket.ResponseDueAt.ToLocalTime().ToString("g")</li>
                <li><strong>Scadenza risoluzione:</strong> @_ticket.ResolutionDueAt.ToLocalTime().ToString("g")</li>
                @if (_ticket.ResolvedAt is not null)
                {
                    <li><strong>Risolto:</strong> @_ticket.ResolvedAt.Value.ToLocalTime().ToString("g")</li>
                }
            </ul>

            @if (_isAgentOrAdmin)
            {
                <h5>Cronologia</h5>
                <ul class="list-unstyled small">
                    @foreach (var entry in _history)
                    {
                        <li class="mb-1">
                            <strong>@entry.FieldName</strong>: @entry.OldValue &rarr; @entry.NewValue
                            <br><span class="text-muted">@entry.ChangedBy?.DisplayName, @entry.ChangedAt.ToLocalTime().ToString("g")</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Ticket? _ticket;
    private List<TicketComment> _comments = new();
    private List<TicketHistoryEntry> _history = new();
    private List<Attachment> _attachments = new();
    private string? _error;
    private bool _isAgentOrAdmin;
    private bool _uploading;
    private readonly NewCommentModel _newComment = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        _isAgentOrAdmin = authState.User.IsInRole("Agent") || authState.User.IsInRole("Admin");

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _ticket = await Api.GetByIdAsync(Id);
            _comments = await Api.GetCommentsAsync(Id);
            _attachments = await Api.GetAttachmentsAsync(Id);
            if (_isAgentOrAdmin)
            {
                _history = await Api.GetHistoryAsync(Id);
            }
            _error = null;
        }
        catch (Exception ex)
        {
            _error = $"Impossibile caricare il ticket: {ex.Message}";
        }
    }

    private async Task TransitionAsync(TicketStatus newStatus)
    {
        try
        {
            await Api.TransitionAsync(Id, newStatus);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = $"Cambio stato fallito: {ex.Message}";
        }
    }

    private async Task AddCommentAsync()
    {
        if (string.IsNullOrWhiteSpace(_newComment.Body))
        {
            return;
        }

        try
        {
            await Api.AddCommentAsync(Id, _newComment.Body);
            _newComment.Body = string.Empty;
            _comments = await Api.GetCommentsAsync(Id);
        }
        catch (Exception ex)
        {
            _error = $"Commento fallito: {ex.Message}";
        }
    }

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        const long maxSize = 10 * 1024 * 1024; // 10 MB — deve combaciare col limite lato server.

        _uploading = true;
        try
        {
            var file = e.File;
            await using var stream = file.OpenReadStream(maxSize);
            await Api.UploadAttachmentAsync(Id, stream, file.Name, file.ContentType);
            _attachments = await Api.GetAttachmentsAsync(Id);
        }
        catch (Exception ex)
        {
            _error = $"Upload allegato fallito: {ex.Message}";
        }
        finally
        {
            _uploading = false;
        }
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:F1} KB",
        _ => $"{bytes / 1024.0 / 1024.0:F1} MB",
    };

    private static bool IsBreached(Ticket t) =>
        t.Status is not (TicketStatus.Resolved or TicketStatus.Closed) && DateTime.UtcNow > t.ResolutionDueAt;

    private static string PriorityColor(TicketPriority p) => p switch
    {
        TicketPriority.Critical => "danger",
        TicketPriority.High => "warning",
        TicketPriority.Medium => "info",
        _ => "secondary",
    };

    private class NewCommentModel
    {
        public string Body { get; set; } = string.Empty;
    }
}
